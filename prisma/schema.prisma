

//


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  email            String             @unique
  emailVerified    Boolean            @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         Session[]
  authAccounts     AuthAccount[]
  dataImports      DataImport[]
  institutions     Institution[]
  assets           Asset[]
  months           PortfolioMonth[]
  targetPlans      TargetPlan[]
  manualQuotes     ManualQuote[]
  moduleGrants     ModuleGrant[]
  roleGrants       RoleGrant[]
  familyContacts   FamilyContact[]
  familySeries     FamilySeries[]
  familyEntries    FamilyEntry[]
  incomeMonths     IncomeMonth[]
  incomePayslips   IncomePayslip[]
  incomeHours      IncomeHourRecord[]
  overtimeMonths   OvertimeMonth[]
  overtimeDays     OvertimeDay[]
  overtimeRules    OvertimeRule[]
  overtimePayments OvertimePayment[]

  @@map("users")
}


enum AppModule {
  FAMILY_EXPENSES

  INCOME
  PENSION
}


enum AppRole {
  ADMIN
}

model ModuleGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  module    AppModule
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@map("module_grants")
}

model RoleGrant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      AppRole
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("role_grants")
}


enum FamilyDirection {
  RECEIVABLE
  PAYABLE
}


enum FamilyEntryStatus {
  PENDING
  SETTLED
}


enum FamilySeriesKind {
  INSTALLMENTS
  MONTHLY
}


model FamilyContact {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  name           String
  normalizedName String         @map("normalized_name")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries        FamilyEntry[]
  series         FamilySeries[]

  @@unique([userId, normalizedName])
  @@unique([id, userId])
  @@map("family_contacts")
}


model FamilySeries {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  contactId       String           @map("contact_id") @db.Uuid
  kind            FamilySeriesKind
  description     String
  direction       FamilyDirection

  amount          Decimal          @db.Decimal(12, 2)
  firstCompetence DateTime         @map("first_competence") @db.Date
  count           Int
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact         FamilyContact    @relation(fields: [contactId, userId], references: [id, userId], onDelete: NoAction)
  entries         FamilyEntry[]

  @@unique([id, userId])
  @@index([userId])
  @@map("family_series")
}


model FamilyEntry {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  contactId   String            @map("contact_id") @db.Uuid
  competence  DateTime          @db.Date
  description String
  direction   FamilyDirection
  amount      Decimal           @db.Decimal(12, 2)
  status      FamilyEntryStatus @default(PENDING)
  seriesId    String?           @map("series_id") @db.Uuid

  installment Int?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact     FamilyContact     @relation(fields: [contactId, userId], references: [id, userId], onDelete: NoAction)
  series      FamilySeries?     @relation(fields: [seriesId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([seriesId, installment])
  @@unique([id, userId])
  @@index([userId, competence])
  @@index([contactId])
  @@map("family_entries")
}


model IncomeMonth {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid

  month            DateTime           @db.Date

  netIncome        Decimal?           @map("net_income") @db.Decimal(12, 2)

  mealVoucher      Decimal?           @map("meal_voucher") @db.Decimal(12, 2)
  cardSpend        Decimal?           @map("card_spend") @db.Decimal(12, 2)
  pixSpend         Decimal?           @map("pix_spend") @db.Decimal(12, 2)

  mealVoucherSpend Decimal?           @map("meal_voucher_spend") @db.Decimal(12, 2)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payslips         IncomePayslip[]
  hourRecords      IncomeHourRecord[]

  @@unique([userId, month])
  @@unique([id, userId])
  @@map("income_months")
}


enum PayslipKind {
  SALARY
  VACATION
  THIRTEENTH
  PROFIT_SHARING
  OTHER
}


model IncomePayslip {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  incomeMonthId String      @map("income_month_id") @db.Uuid
  kind          PayslipKind @default(SALARY)

  label         String?
  employer      String
  startsOn      DateTime    @map("starts_on") @db.Date
  endsOn        DateTime    @map("ends_on") @db.Date

  grossSalary   Decimal     @map("gross_salary") @db.Decimal(12, 2)

  prorated      Boolean     @default(false)


  taxable       Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         IncomeMonth @relation(fields: [incomeMonthId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([incomeMonthId])
  @@index([userId, startsOn])
  @@map("income_payslips")
}


// trabalhadas e ficam fora.
enum HourKind {
  NORMAL
  OVERTIME_50
  OVERTIME_75
  OVERTIME_100
}


model IncomeHourRecord {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  incomeMonthId String      @map("income_month_id") @db.Uuid
  kind          HourKind

  paidHours     Decimal?    @map("paid_hours") @db.Decimal(7, 2)

  paidAmount    Decimal?    @map("paid_amount") @db.Decimal(12, 2)

  note          String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         IncomeMonth @relation(fields: [incomeMonthId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([incomeMonthId, kind])
  @@unique([id, userId])
  @@index([userId])
  @@map("income_hour_records")
}


enum OvertimeSource {
  IMPORT
  MANUAL
}


enum OvertimeDayType {
  WORKDAY
  SATURDAY
  SUNDAY
  HOLIDAY
}


model OvertimeMonth {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid

  month              DateTime          @db.Date
  startsOn           DateTime          @map("starts_on") @db.Date
  endsOn             DateTime          @map("ends_on") @db.Date
  source             OvertimeSource

  weekdayHours       Decimal           @default(0) @map("weekday_hours") @db.Decimal(7, 2)

  weekdayBeyondHours Decimal           @default(0) @map("weekday_beyond_hours") @db.Decimal(7, 2)
  saturdayHours      Decimal           @default(0) @map("saturday_hours") @db.Decimal(7, 2)
  sundayHours        Decimal           @default(0) @map("sunday_hours") @db.Decimal(7, 2)
  holidayHours       Decimal           @default(0) @map("holiday_hours") @db.Decimal(7, 2)

  shortfallHours     Decimal           @default(0) @map("shortfall_hours") @db.Decimal(7, 2)

  compensatedHours   Decimal           @default(0) @map("compensated_hours") @db.Decimal(7, 2)

  sourceName         String?           @map("source_name")

  importWarnings     String[]          @default([]) @map("import_warnings")
  note               String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  days               OvertimeDay[]
  payments           OvertimePayment[]

  @@unique([userId, month])
  @@unique([id, userId])
  @@map("overtime_months")
}


model OvertimePayment {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  overtimeMonthId String        @map("overtime_month_id") @db.Uuid

  paymentMonth    DateTime      @map("payment_month") @db.Date


  hours50         Decimal       @default(0) @map("hours_50") @db.Decimal(7, 2)
  hours75         Decimal       @default(0) @map("hours_75") @db.Decimal(7, 2)
  hours100        Decimal       @default(0) @map("hours_100") @db.Decimal(7, 2)
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           OvertimeMonth @relation(fields: [overtimeMonthId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([overtimeMonthId, paymentMonth])
  @@unique([id, userId])
  @@index([userId])
  @@map("overtime_payments")
}


model OvertimeDay {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  overtimeMonthId String          @map("overtime_month_id") @db.Uuid
  date            DateTime        @db.Date
  hours           Decimal         @db.Decimal(5, 2)
  dayType         OvertimeDayType @map("day_type")

  manualType      Boolean         @default(false) @map("manual_type")
  activity        String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           OvertimeMonth   @relation(fields: [overtimeMonthId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([overtimeMonthId, date])
  @@unique([id, userId])
  @@index([userId])
  @@map("overtime_days")
}


model OvertimeRule {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  effectiveFrom         DateTime @map("effective_from") @db.Date
  dailyHours            Decimal  @map("daily_hours") @db.Decimal(4, 2)
  weekdayPercent        Int      @map("weekday_percent")
  weekdayBeyondPercent  Int      @map("weekday_beyond_percent")
  saturdayPercent       Int      @map("saturday_percent")
  sundayPercent         Int      @map("sunday_percent")
  holidayPercent        Int      @map("holiday_percent")

  usualDailyLimit       Decimal? @map("usual_daily_limit") @db.Decimal(4, 2)
  exceptionalDailyLimit Decimal? @map("exceptional_daily_limit") @db.Decimal(4, 2)

  netShortfall          Boolean  @default(false) @map("net_shortfall")
  note                  String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, effectiveFrom])
  @@unique([id, userId])
  @@map("overtime_rules")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}


model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}


model DataImport {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  importedAt    DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)

  exportedAt    DateTime @map("exported_at") @db.Timestamptz(3)
  formatVersion Int      @map("format_version")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, importedAt])
  @@map("data_imports")
}


enum PortfolioMonthStatus {
  DRAFT
  REVIEWED
}

model Institution {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  normalizedName String    @map("normalized_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts       Account[]

  @@unique([userId, normalizedName])
  @@unique([id, userId])
  @@map("institutions")
}

model Account {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  name          String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)


  institution   Institution @relation(fields: [institutionId, userId], references: [id, userId], onDelete: NoAction)
  positions     Position[]

  @@unique([institutionId, name])
  @@unique([id, userId])
  @@index([userId])
  @@map("accounts")
}

model Asset {
  fixedIncomeContract Json? @map("fixed_income_contract")
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  normalizedKey   String     @map("normalized_key")
  name            String
  ticker          String?
  quoteSymbol     String?    @map("quote_symbol")
  baseCurrency    String     @map("base_currency")


  maturityDate    DateTime?  @map("maturity_date") @db.Date


  liquidity       String?


  quoteProviderId String?    @map("quote_provider_id")


  cashAccount     Boolean    @default(false) @map("cash_account")


  cdiPercent      Decimal?   @map("cdi_percent") @db.Decimal(7, 3)
  appliedOn       DateTime?  @map("applied_on") @db.Date


  autoIncome      Boolean    @default(false) @map("auto_income")


  assetType       String?    @map("asset_type")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions       Position[]

  @@unique([userId, normalizedKey])
  @@unique([id, userId])
  @@index([ticker])
  @@map("assets")
}

model PortfolioMonth {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  referenceDate DateTime             @map("reference_date") @db.Date
  status        PortfolioMonthStatus @default(REVIEWED)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions     Position[]

  @@unique([userId, referenceDate])
  @@unique([id, userId])
  @@index([referenceDate])
  @@map("portfolio_months")
}

model Position {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @map("user_id") @db.Uuid
  portfolioMonthId        String                @map("portfolio_month_id") @db.Uuid
  accountId               String                @map("account_id") @db.Uuid
  assetId                 String                @map("asset_id") @db.Uuid
  quantity                Decimal               @db.Decimal(30, 12)


  openingQuantity         Decimal               @default(0) @map("opening_quantity") @db.Decimal(30, 12)

  calculationStartDate    DateTime?             @map("calculation_start_date") @db.Date

  calculatedIncomeBrl     Decimal               @default(0) @map("calculated_income_brl") @db.Decimal(24, 8)
  incomeCalculatedThrough DateTime?             @map("income_calculated_through") @db.Date
  incomeCalculationError  String?               @map("income_calculation_error")
  unitPriceBrl            Decimal?              @map("unit_price_brl") @db.Decimal(24, 8)
  exchangeRateBrl         Decimal?              @map("exchange_rate_brl") @db.Decimal(20, 8)
  totalBrl                Decimal               @map("total_brl") @db.Decimal(24, 2)
  strategy                String?
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  portfolioMonth          PortfolioMonth        @relation(fields: [portfolioMonthId, userId], references: [id, userId], onDelete: Cascade)
  account                 Account               @relation(fields: [accountId, userId], references: [id, userId], onDelete: NoAction)
  asset                   Asset                 @relation(fields: [assetId, userId], references: [id, userId], onDelete: NoAction)
  allocations             PositionAllocation[]
  transactions            PositionTransaction[]

  @@unique([portfolioMonthId, accountId, assetId])
  @@unique([id, userId])
  @@index([portfolioMonthId])
  @@index([accountId])
  @@index([assetId])
  @@map("positions")
}


enum PositionTransactionKind {
  CONTRIBUTION
  WITHDRAWAL
  INCOME
  OPENING
}


model PositionTransaction {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @map("user_id") @db.Uuid
  positionId   String                  @map("position_id") @db.Uuid
  kind         PositionTransactionKind
  occurredOn   DateTime                @map("occurred_on") @db.Date


  quantity     Decimal                 @db.Decimal(30, 12)


  unitPriceBrl Decimal?                @map("unit_price_brl") @db.Decimal(24, 8)


  amountBrl    Decimal                 @map("amount_brl") @db.Decimal(24, 2)
  note         String?


  transferId   String?                 @map("transfer_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  position     Position                @relation(fields: [positionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([positionId, occurredOn])
  @@index([userId])
  @@index([transferId])
  @@map("position_transactions")
}


model RateObservation {
  id           String   @id @default(uuid()) @db.Uuid
  indexer      String
  date         DateTime @db.Date
  dailyPercent Decimal  @map("daily_percent") @db.Decimal(18, 12)
  source       String
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(3)

  @@unique([indexer, date])
  @@index([date])
  @@map("rate_observations")
}


model RateCoverage {
  id                String    @id @default(uuid()) @db.Uuid
  indexer           String
  fromDate          DateTime  @map("from_date") @db.Date
  throughDate       DateTime  @map("through_date") @db.Date
  lastPublishedDate DateTime? @map("last_published_date") @db.Date
  fetchedAt         DateTime  @map("fetched_at") @db.Timestamptz(3)

  @@unique([indexer, fromDate, throughDate])
  @@map("rate_coverage")
}


model ReferenceRate {
  key           String    @id
  percentAnnual Decimal?  @map("percent_annual") @db.Decimal(12, 6)
  observedOn    DateTime? @map("observed_on") @db.Date
  source        String?
  fetchedAt     DateTime? @map("fetched_at") @db.Timestamptz(3)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  errorMessage  String?   @map("error_message")

  @@map("reference_rates")
}


model ReferenceRatePoint {
  key           String
  effectiveOn   DateTime @map("effective_on") @db.Date
  percentAnnual Decimal  @map("percent_annual") @db.Decimal(12, 6)

  @@id([key, effectiveOn])
  @@map("reference_rate_points")
}

model MarketQuote {
  id             String    @id @default(uuid()) @db.Uuid
  referenceDate  DateTime  @map("reference_date") @db.Date
  symbol         String
  instrumentType String    @map("instrument_type")
  baseCurrency   String    @map("base_currency")
  valueBrl       Decimal   @map("value_brl") @db.Decimal(24, 8)


  quoteDate      DateTime? @map("quote_date") @db.Date


  carriedFrom    DateTime? @map("carried_from") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([referenceDate, symbol])
  @@index([symbol])
  @@map("market_quotes")
}


model ManualQuote {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  referenceDate  DateTime @map("reference_date") @db.Date
  symbol         String
  instrumentType String   @map("instrument_type")
  baseCurrency   String   @map("base_currency")
  valueBrl       Decimal  @map("value_brl") @db.Decimal(24, 8)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceDate, symbol])
  @@index([referenceDate, symbol])
  @@map("manual_quotes")
}

enum QuoteRefreshStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
}


// sobrescreve o valor daquele dia, nunca o de outro.
model DailyQuote {
  id             String           @id @default(uuid()) @db.Uuid
  symbol         String
  quoteDate      DateTime         @map("quote_date") @db.Date
  instrumentType String           @map("instrument_type")
  baseCurrency   String           @map("base_currency")
  valueBrl       Decimal          @map("value_brl") @db.Decimal(24, 8)
  provider       String
  fetchedAt      DateTime         @map("fetched_at") @db.Timestamptz(3)
  runId          String?          @map("run_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  run            QuoteRefreshRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([symbol, quoteDate])
  @@index([quoteDate])
  @@map("daily_quotes")
}


enum QuoteSymbolStatus {
  PENDING
  ACTIVE
  ERROR
}


model QuoteSymbol {
  symbol             String            @id
  instrumentType     String            @map("instrument_type")
  baseCurrency       String            @map("base_currency")

  providerId         String?           @map("provider_id")
  status             QuoteSymbolStatus @default(PENDING)
  lastAttemptAt      DateTime?         @map("last_attempt_at") @db.Timestamptz(3)
  lastSuccessAt      DateTime?         @map("last_success_at") @db.Timestamptz(3)

  failureCount       Int               @default(0) @map("failure_count")
  lastErrorCode      String?           @map("last_error_code")
  lastErrorMessage   String?           @map("last_error_message")

  nextAttemptAt      DateTime?         @map("next_attempt_at") @db.Timestamptz(3)

  /// primeiro carregamento.
  historySyncedUntil DateTime?         @map("history_synced_until") @db.Date
  historyAttemptedAt DateTime?         @map("history_attempted_at") @db.Timestamptz(3)
  historyError       String?           @map("history_error")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("quote_symbols")
}

model QuoteRefreshRun {
  id            String               @id @default(uuid()) @db.Uuid
  status        QuoteRefreshStatus   @default(RUNNING)
  quoteDate     DateTime             @map("quote_date") @db.Date

  repricedMonth DateTime?            @map("repriced_month") @db.Date
  startedAt     DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?            @map("finished_at") @db.Timestamptz(3)
  errorMessage  String?              @map("error_message")
  results       QuoteRefreshResult[]
  dailyQuotes   DailyQuote[]

  @@index([startedAt])
  @@index([status])
  @@map("quote_refresh_runs")
}

model QuoteRefreshResult {
  id           BigInt            @id @default(autoincrement())
  runId        String            @map("run_id") @db.Uuid
  symbol       String
  provider     String
  status       QuoteUpdateStatus
  valueBrl     Decimal?          @map("value_brl") @db.Decimal(24, 8)
  errorCode    String?           @map("error_code")
  errorMessage String?           @map("error_message")
  fetchedAt    DateTime          @default(now()) @map("fetched_at") @db.Timestamptz(3)
  run          QuoteRefreshRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, symbol])
  @@index([runId, status])
  @@map("quote_refresh_results")
}

enum QuoteUpdateStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model PositionAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  positionId  String   @map("position_id") @db.Uuid
  assetClass  String   @map("asset_class")
  subclass    String
  duration    String
  weight      Decimal  @db.Decimal(12, 10)


  ratePercent Decimal? @map("rate_percent") @db.Decimal(9, 4)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  position    Position @relation(fields: [positionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([positionId, assetClass, subclass, duration])
  @@index([positionId])
  @@map("position_allocations")
}

enum AllocationTargetScope {
  ASSET_CLASS
  CURRENCY
  STRATEGY
  CLASS_CURRENCY
  FIXED_INCOME
  VARIABLE_INCOME
}

model TargetPlan {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  name             String
  isActive         Boolean            @default(true) @map("is_active")
  tolerancePercent Decimal            @default(2) @map("tolerance_percent") @db.Decimal(5, 2)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets          AllocationTarget[]

  @@unique([id, userId])
  @@index([userId])
  @@map("target_plans")
}

model AllocationTarget {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  planId         String                @map("plan_id") @db.Uuid
  key            String
  scope          AllocationTargetScope
  primaryLabel   String                @map("primary_label")
  secondaryLabel String?               @map("secondary_label")
  percentage     Decimal               @db.Decimal(12, 10)
  plan           TargetPlan            @relation(fields: [planId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId, scope])
  @@map("allocation_targets")
}
