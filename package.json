{
  "name": "my-portifolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:test-schema": "tsx scripts/db-test-schema.ts",
    "backup:export": "tsx scripts/backup.ts export",
    "backup:restore": "tsx scripts/backup.ts restore",
    "auth:user": "tsx scripts/auth-user.ts",
    "auth:access": "tsx scripts/access.ts",
    "quotes:sync": "tsx scripts/quotes-sync.ts",
    "jobs:build": "node jobs/neon/build.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "1.7.7",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "exceljs": "4.4.0",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "nuqs": "^2.10.1",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@neon/config": "1.8.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
